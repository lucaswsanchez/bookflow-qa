{
  "name": "bookflow-qa",
  "version": "1.0.0",
  "private": true,
  "description": "QA suite for BookFlow: Playwright E2E (POM), accessibility, API and Postman/Newman tests",
  "license": "MIT",
  "author": "Lucas Sanchez",
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "newman": "newman run postman/bookflow.postman_collection.json -e postman/live.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/newman/index.html --reporter-htmlextra-title \"BookFlow API - Newman report\"",
    "warmup": "node scripts/warmup.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "globals": "^17.14.0",
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
